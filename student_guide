<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الموجّه الجامعي الذكي - مكتبة الكلية</title>
    
    <style>
        /* خط Cairo (Mohamed Gaber / Accademia di Belle Arti di Urbino) مرخّص بـ SIL OFL 1.1 — مدمج للعمل دون إنترنت */
        @font-face {
            font-family: 'Cairo';
            font-style: normal;
            font-weight: 400 900;
            font-display: swap;
            src: url("data:font/woff;base64,") format('woff');
        }

        :root {
            --brand: #0d7d73;
            --brand-dark: #0a6b63;
            --brand-text: #0b7a70;
            --ink: #2c3e50;
            --muted: #6b7280;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        #chat-container {
            width: 100%;
            max-width: 600px;
            height: 90vh;
            height: 90dvh;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        /* ===== الرأس (مضغوط) ===== */
        .chat-header {
            background: rgba(255, 255, 255, 0.96);
            padding: 14px 20px 12px;
            text-align: center;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .logo-container {
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 0;
        }
        .logo-container img {
            display: block;
            height: 96px;
            width: auto;
            max-width: 100%;
            object-fit: contain;
        }
        .logo-fallback {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 100%);
            color: #fff;
            font-size: 2rem;
            box-shadow: 0 4px 12px rgba(13, 125, 115, 0.3);
        }
        .chat-header h2 {
            color: var(--ink);
            font-size: 1.65rem;
            font-weight: 900;
            line-height: 1.35;
            margin-bottom: 2px;
        }
        .chat-header .arabic-subtitle {
            color: var(--brand-text);
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.5;
        }
        .chat-header .english-subtitle {
            color: var(--muted);
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1.4;
            direction: ltr;
        }

        /* ===== منطقة المحادثة ===== */
        #chat-history {
            flex: 1;
            padding: 22px 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
            scroll-behavior: smooth;
            background: rgba(250, 250, 250, 0.5);
            position: relative;
        }
        #chat-history::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 16rem;
            height: 16rem;
            transform: translate(-50%, -50%);
            background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%20512%20512%27%3E%3Cpath%20fill%3D%27rgb%2813%2C125%2C115%29%27%20fill-opacity%3D%270.05%27%20d%3D%27M271.9%2020.2c-9.8-5.6-21.9-5.6-31.8%200l-224%20128c-12.6%207.2-18.8%2022-15.1%2036S17.5%20208%2032%20208h32v208l-51.2%2038.4C4.7%20460.4%200%20469.9%200%20480c0%2017.7%2014.3%2032%2032%2032h448c17.7%200%2032-14.3%2032-32%200-10.1-4.7-19.6-12.8-25.6L448%20416V208h32c14.5%200%2027.2-9.8%2030.9-23.8s-2.5-28.8-15.1-36l-224-128zM400%20208v208h-64V208zm-112%200v208h-64V208zm-112%200v208h-64V208zm80-112a32%2032%200%201%201%200%2064%2032%2032%200%201%201%200-64%27%2F%3E%3C%2Fsvg%3E") center / contain no-repeat;
            pointer-events: none;
            z-index: 0;
        }
        #chat-history::-webkit-scrollbar { width: 6px; }
        #chat-history::-webkit-scrollbar-thumb { background-color: rgba(13, 125, 115, 0.3); border-radius: 10px; }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .msg-wrapper {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            animation: slideUp 0.3s ease-out forwards;
            z-index: 1;
        }
        .msg-wrapper.bot { flex-direction: row; }
        .msg-wrapper.user { flex-direction: row-reverse; }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .msg-wrapper.bot .avatar { background: #e3f2fd; color: #1976d2; }
        .msg-wrapper.user .avatar { background: var(--brand); color: white; }

        .message {
            max-width: 80%;
            padding: 12px 18px;
            border-radius: 18px;
            font-size: 1rem;
            line-height: 1.8;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        }
        .bot-message {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            color: #34495e;
            border-bottom-right-radius: 4px;
            border: 1px solid rgba(0,0,0,0.04);
        }
        .bot-message-ltr {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            color: #34495e;
            border-bottom-left-radius: 4px;
            border-bottom-right-radius: 18px;
            border: 1px solid rgba(0,0,0,0.04);
            direction: ltr;
            text-align: left;
        }
        .user-message {
            background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 100%);
            color: #ffffff;
            border-bottom-left-radius: 4px;
        }
        .user-message-ltr {
            background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 100%);
            color: #ffffff;
            border-bottom-right-radius: 4px;
            direction: ltr;
            text-align: left;
        }
        .bot-message strong { color: var(--brand-text); }
        .lang-switch { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; direction: ltr; }
        .lang-btn {
            font-family: 'Cairo', sans-serif; font-size: 0.8rem; font-weight: 700;
            padding: 3px 12px; border-radius: 999px; cursor: pointer;
            border: 1px solid rgba(13, 125, 115, 0.35); background: #ffffff; color: var(--brand-text);
            transition: background 0.2s ease, border-color 0.2s ease;
        }
        .lang-btn:hover { background: #e8f6f4; border-color: var(--brand); }
        .lang-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .fb-row { margin: 4px 0 10px; line-height: 1.9; }
        .fb-row:last-of-type { margin-bottom: 0; }
        .fb-row .lang-btn { margin: 2px 3px; }
        .message .designer-name {
            color: #0b7a70;
            font-weight: 900;
            letter-spacing: 0.2px;
        }
        .fa-i {
            display: inline-block;
            width: 1em;
            height: 1em;
            fill: currentColor;
            vertical-align: -0.125em;
            flex-shrink: 0;
        }
        .status-bar .fa-i { color: var(--brand); margin-inline-end: 5px; }
        .chip .fa-i { font-size: 0.9rem; }
        .input-wrapper .fa-i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9aa3ab;
        }
        .welcome-avatar {
            width: 46px;
            height: 46px;
            vertical-align: middle;
            margin: -12px 2px -8px;
        }
        .welcome-en {
            display: block;
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px dashed rgba(13, 125, 115, 0.25);
            color: #0b8a5a;
            font-size: 0.84rem;
            font-weight: 800;
            text-wrap: balance;
            letter-spacing: 0.2px;
            line-height: 1.5;
            direction: ltr;
            text-align: left;
        }

        /* ===== مؤشر الكتابة ===== */
        .typing { display: inline-flex; align-items: center; gap: 5px; padding: 6px 2px; }
        .typing span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #9aa8b0;
            animation: blink 1.2s infinite ease-in-out;
        }
        .typing span:nth-child(2) { animation-delay: 0.2s; }
        .typing span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes blink {
            0%, 80%, 100% { opacity: 0.25; transform: scale(0.85); }
            40% { opacity: 1; transform: scale(1); }
        }

        /* ===== شريط التاريخ والوقت وحالة المكتبة ===== */
        .status-bar {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 6px 12px;
            margin-top: 6px;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--muted);
        }
        .status-bar > span { display: inline-flex; align-items: center; }
        .status-bar i { color: var(--brand); margin-inline-end: 5px; }
        .open-badge {
            gap: 6px;
            padding: 2px 11px;
            border-radius: 999px;
            border: 1px solid transparent;
            font-weight: 700;
        }
        .open-badge .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
        .open-badge.open { background: #e7f6ee; color: #0b6b3a; border-color: #a7dcc0; }
        .open-badge.open .dot { animation: pulse 1.8s infinite ease-in-out; }
        .open-badge.closed { background: #fdecec; color: #a12626; border-color: #f1b6b6; }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.45; transform: scale(0.8); }
        }
        .msg-time {
            display: block;
            margin-top: 2px;
            font-size: 0.68rem;
            font-weight: 600;
            line-height: 1.2;
            opacity: 0.65;
            text-align: end;
            direction: ltr;
        }
        .user-message .msg-time, .user-message-ltr .msg-time { opacity: 0.85; }

        /* ===== أزرار الأسئلة السريعة ===== */
        .quick-actions {
            display: flex;
            gap: 8px;
            padding: 10px 14px;
            overflow-x: auto;
            background: rgba(255, 255, 255, 0.96);
            border-top: 1px solid rgba(0,0,0,0.05);
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }
        .quick-actions::-webkit-scrollbar { display: none; }
        .chip {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid rgba(13, 125, 115, 0.35);
            background: #ffffff;
            color: var(--brand-text);
            font-family: 'Cairo', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
            transition: background 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }
        .chip i { font-size: 0.9rem; }
        .chip:hover { background: #e8f6f4; border-color: var(--brand); box-shadow: 0 2px 8px rgba(13, 125, 115, 0.18); }
        .chip:active { background: #d4efeb; }
        a.chip { text-decoration: none; }
        .chip-link { background: #e8f6f4; border-color: rgba(13, 125, 115, 0.5); }
        .chip-link:hover { background: #d4efeb; }

        /* ===== حقل الإدخال ===== */
        .input-area {
            background: rgba(255, 255, 255, 0.96);
            padding: 12px 20px;
            display: flex;
            gap: 12px;
            border-top: 1px solid rgba(0,0,0,0.05);
        }
        .input-wrapper { flex: 1; position: relative; }
        .input-wrapper i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9aa3ab;
        }
        input {
            width: 100%;
            padding: 14px 40px 14px 20px;
            border: 1px solid #e0e0e0;
            border-radius: 30px;
            font-size: 1rem;
            font-family: 'Cairo', sans-serif;
            background: #f8f9fa;
            transition: all 0.3s ease;
            outline: none;
        }
        input:focus { background: #ffffff; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(13, 125, 115, 0.2); }

        .send-btn {
            padding: 0 22px;
            background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 100%);
            color: white;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            font-family: 'Cairo', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 4px 15px rgba(13, 125, 115, 0.4);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .send-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(13, 125, 115, 0.55); }
        .send-btn:active { transform: translateY(0); }
        .send-btn:focus-visible, .chip:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

        /* ===== حقوق الملكية ===== */
        .copyright-footer {
            width: 100%;
            text-align: center;
            padding: 6px 10px 9px;
            background: rgba(255, 255, 255, 0.96);
            color: var(--muted);
            font-family: 'Cairo', sans-serif;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            direction: ltr;
        }
        .copyright-footer strong { color: var(--brand-text); font-weight: 700; }

        @media (min-width: 601px) {
            .quick-actions { flex-wrap: wrap; justify-content: center; overflow-x: visible; }
        }

        /* ===== الهاتف المحمول ===== */
        @media (max-width: 600px) {
            body { padding: 0; }
            #chat-container {
                height: 100vh;
                height: 100dvh;
                border-radius: 0;
                border: none;
            }
            .chat-header { padding: 10px 10px 8px; }
            .logo-container { margin-bottom: 4px; }
            .logo-container img { height: 66px; }
            .logo-fallback { width: 56px; height: 56px; font-size: 1.5rem; }
            .chat-header h2 { font-size: 1.3rem; margin-bottom: 0; }
            .chat-header .arabic-subtitle { font-size: 0.85rem; }
            .chat-header .english-subtitle { font-size: 0.65rem; }
            .status-bar { font-size: 0.7rem; gap: 4px 8px; margin-top: 4px; }
            .open-badge { padding: 1px 9px; }
            #chat-history { padding: 15px; }
            #chat-history::before { width: 11rem; height: 11rem; }
            .quick-actions { padding: 8px 12px; }
            .input-area { padding: 10px 12px; }
            .send-btn { padding: 0 16px; }
            .copyright-footer { font-size: 0.68rem; padding: 4px 10px 7px; }
        }


        /* ===== فقاعة الروبوت التفاعلية (تظهر عند الضغط على أيقونة الروبوت) ===== */
        .msg-wrapper.bot .avatar { cursor: pointer; position: relative; transition: transform .2s; }
        .msg-wrapper.bot .avatar:hover { transform: scale(1.12); }
        .msg-wrapper.bot .avatar.wiggle { animation: botWiggle .7s ease; }
        .msg-wrapper.bot .avatar.wiggle::after {
            content: ''; position: absolute; inset: -2px; border-radius: 50%;
            border: 2px solid #1976d2; animation: botRipple .8s ease-out forwards; pointer-events: none;
        }
        @keyframes botWiggle { 0%,100% { transform: rotate(0) scale(1); } 20% { transform: rotate(-16deg) scale(1.18); } 45% { transform: rotate(14deg) scale(1.18); } 70% { transform: rotate(-8deg) scale(1.08); } }
        @keyframes botRipple { from { opacity: .8; transform: scale(1); } to { opacity: 0; transform: scale(2.3); } }
        .bot-bubble {
            position: fixed; z-index: 1000; width: 230px; max-width: calc(100vw - 24px);
            background: #fff; border-radius: 18px; padding: 12px 14px 11px;
            box-shadow: 0 10px 30px rgba(11,122,112,.28), 0 2px 8px rgba(0,0,0,.12);
            border: 2px solid transparent;
            background-image: linear-gradient(#fff,#fff), linear-gradient(135deg,#11998e,#38ef7d);
            background-origin: border-box; background-clip: padding-box, border-box;
            opacity: 0; transform: translateY(8px) scale(.6); transform-origin: var(--tx,50%) var(--ty,100%);
            transition: opacity .25s ease, transform .35s cubic-bezier(.2,1.5,.4,1);
            pointer-events: auto; cursor: pointer;
        }
        .bot-bubble.show { opacity: 1; transform: none; animation: bubbleFloat 3s ease-in-out .4s infinite; }
        .bot-bubble:hover { animation-play-state: paused; }
        .bot-bubble.hide { opacity: 0; transform: translateY(-6px) scale(.85); transition: all .25s ease; animation: none; }
        @keyframes bubbleFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
        .bot-bubble::after {
            content: ''; position: absolute; left: var(--tail,30px); width: 14px; height: 14px; background: #fff;
            transform: rotate(45deg); border-radius: 3px;
        }
        .bot-bubble.up::after { bottom: -8px; border-right: 2px solid #2bc48a; border-bottom: 2px solid #2bc48a; }
        .bot-bubble.down::after { top: -8px; border-left: 2px solid #1fb08a; border-top: 2px solid #1fb08a; }
        .bb-title { font-weight: 800; color: var(--brand-text); font-size: .98rem; text-align: center; margin-bottom: 4px; }
        .bb-row { display: flex; align-items: center; gap: 8px; padding: 2px 0; font-size: .88rem; color: var(--ink); animation: bbIn .4s ease backwards; border-radius: 10px; }
        .bb-row:nth-child(2) { animation-delay: .12s; } .bb-row:nth-child(3) { animation-delay: .24s; } .bb-row:nth-child(4) { animation-delay: .36s; }
        @keyframes bbIn { from { opacity: 0; transform: translateY(6px); } }
        .bb-row.ask { cursor: pointer; padding: 4px 6px; margin: 1px -6px; transition: background .15s; }
        .bb-row.ask:hover { background: #e8f7f3; }
        .bb-hint { text-align: center; font-size: .7rem; color: var(--muted); margin-top: 5px; }
        .bb-tag { flex: 0 0 auto; min-width: 26px; text-align: center; font-size: .66rem; font-weight: 800; color: #fff; background: var(--brand); border-radius: 8px; padding: 1px 5px; }
        .bb-row .bb-txt { flex: 1; font-weight: 700; }
        .bb-spark { position: fixed; z-index: 999; pointer-events: none; font-size: 15px; animation: sparkUp 1.3s ease-out forwards; }
        @keyframes sparkUp { from { opacity: 1; transform: translate(0,0) scale(.6); } to { opacity: 0; transform: translate(var(--dx),-60px) scale(1.2); } }

        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; }
        }
    </style>
</head>
