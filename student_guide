<div id="chat-container">
    <div class="chat-header">
        <div class="logo-container">
            <img src="data:image/png;base64," alt="شعار جامعة 8 ماي 1945 قالمة" onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex'">
