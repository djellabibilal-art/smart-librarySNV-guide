    function normalize(t) {
        return t.toLowerCase()
            .replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي')
            .replace(/ئ/g, 'ي').replace(/ؤ/g, 'و')
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')          // حذف علامات اللاتينية (é è à ...)
            .replace(/[\u064B-\u065F\u0670\u0640]/g, '')               // حذف التشكيل والتطويل العربي
            .replace(/[’‘`´]/g, "'")
            .replace(/[?؟!.,،;:()"«»]/g, ' ')
            .replace(/(.)\1{2,}/g, '$1')                              // تكرار مبالغ فيه: المكتبةةة / helloooo
            .replace(/\s+/g, ' ')
            .trim();
    }

    function escapeRegex(s) {
        return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // ====== 2) بناء قواعد المطابقة مرة واحدة مع وزن كل كلمة ======
    // عدد الأغراض التي تشترك في نفس الكلمة (كلما كثر الاشتراك قلّ الوزن)
    const kwIntents = {};
    for (const intent in keywordsDictionary)
        for (const lang in keywordsDictionary[intent])
            for (const kw of keywordsDictionary[intent][lang]) {
                const k = normalize(kw);
                (kwIntents[k] = kwIntents[k] || new Set()).add(intent);
            }

    function buildRegex(k) {
        const body = escapeRegex(k).replace(/ /g, '\\s+');
        if (/[a-z]/.test(k)) {
            // لاتيني: بداية كلمة؛ والكلمات القصيرة (≤4) تتطابق كاملة فقط (تمنع: ou داخل hours)
            return new RegExp('(^|[^a-z0-9])' + body + (k.length <= 4 ? "([^a-z0-9]|$)" : ''));
        }
        // عربي: بداية كلمة مع بادئات اختيارية (و/ف + ب/ل/ك + ال) (تمنع: كتب داخل مكتبة)
        return new RegExp('(^|\\s)(?:و|ف)?(?:ب|ل|ك)?(?:ال|ل)?' + body);
    }

    // كلمات عامة جداً تظهر في أسئلة كثيرة: وزنها منخفض حتى لا تغلب العبارات المحدِّدة
    const GENERIC_WORDS = new Set(['كتاب', 'كتب', 'book', 'books', 'livre', 'livres']);

    const compiled = {};
    for (const intent in keywordsDictionary) {
        const seen = new Set();
        compiled[intent] = [];
        for (const lang in keywordsDictionary[intent])
            for (const kw of keywordsDictionary[intent][lang]) {
                const k = normalize(kw);
                if (seen.has(k)) continue;
                seen.add(k);
                const words = k.split(' ').length;
                // العبارة الأطول = وزن أعلى، والكلمة المشتركة بين أغراض = وزن أقل
                const w = GENERIC_WORDS.has(k) ? 1 : words * 2 / kwIntents[k].size;
                compiled[intent].push({ re: buildRegex(k), weight: w });
            }
    }

    // ====== 3) اختيار الغرض الأعلى نقاطاً ======
    // سؤال لا يحوي سوى كلمة «المكتبة» (بأي لغة): نعرض ما تقدمه المكتبة كجواب تعريفي
    const BARE_LIBRARY = new Set([
        'مكتبه', 'المكتبه', 'مكتبه الكليه', 'المكتبه الكليه', 'مكتبة', 'مكتبه الكلية',
        'library', 'the library', 'faculty library', 'the faculty library',
        'bibliotheque', 'la bibliotheque', 'bibliotheque de la faculte', 'la bibliotheque de la faculte'
    ].map(normalize));

    // ====== 3-ب) تسامح مع الأخطاء الإملائية (طالب مبتدئ قد يخطئ في الكتابة) ======
    // مفردات: كل كلمة من القاموس (منفصلة) مع الأغراض واللغات التي تنتمي إليها
    const fuzzyVocab = {};
    (function () {
        const add = (tok, intent, lang) => {
            const e = fuzzyVocab[tok] = fuzzyVocab[tok] || { intents: new Set(), langs: new Set() };
            if (intent) e.intents.add(intent);
            e.langs.add(lang);
        };
        for (const intent in keywordsDictionary)
            for (const lang in keywordsDictionary[intent])
                for (const kw of keywordsDictionary[intent][lang])
                    normalize(kw).split(' ').forEach(t => {
                        t = t.replace(/^(?:و|ف)?(?:ب|ل|ك)?ال/, '');
                        const min = /[a-z]/.test(t) ? 5 : 4;
                        if (t.length >= min && !GENERIC_WORDS.has(t)) add(t, intent, lang);
                    });
        // كلمة «المكتبة» وحدها تعني تعريف المكتبة وخدماتها
        add('library', 'library_services', 'en'); add('bibliotheque', 'library_services', 'fr'); add('مكتبه', 'library_services', 'ar');
    })();
    const fuzzyTokens = Object.keys(fuzzyVocab);

    // مسافة التحرير (حرف زائد/ناقص/مبدّل/متبادل المكان = خطأ واحد)
    function editDistance(a, b) {
        const d = [];
        for (let i = 0; i <= a.length; i++) { d[i] = [i]; }
        for (let j = 0; j <= b.length; j++) d[0][j] = j;
        for (let i = 1; i <= a.length; i++)
            for (let j = 1; j <= b.length; j++) {
                d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
                if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
            }
        return d[a.length][b.length];
    }

    function fuzzyIntent(nq) {
        const scores = {}, ev = { ar: 0, fr: 0, en: 0, shared: 0 };
        nq.split(' ').forEach(raw => {
            const lat = /[a-z]/.test(raw);
            const t = lat ? raw.replace(/(.)\1{2,}/g, '$1$1') : raw.replace(/^(?:و|ف)?(?:ب|ل|ك)?ال/, '').replace(/(.)\1{1,}/g, '$1');
            if (t.length < (lat ? 5 : 4)) return;
            const max = lat ? (t.length >= 8 ? 2 : 1) : (t.length >= 6 ? 2 : 1);
            let best = null, bestD = 99;
            for (const v of fuzzyTokens) {
                if (Math.abs(v.length - t.length) > max && !(lat && t.length >= 6 && v.length > t.length)) continue;
                if (v[0] !== t[0] && !(t.length >= 6 && editDistance(t, v) <= 1)) continue;
                // كلمة مبتورة (bibliotek / ouvertur): تطابق بداية كلمة القاموس
                let dist = (lat && t.length >= 6 && v.startsWith(t)) ? 0 : editDistance(t, v);
                if (lat && t.length >= 7 && v.length > t.length) dist = Math.min(dist, editDistance(t, v.slice(0, t.length)));
                if (dist <= max && dist < bestD) { bestD = dist; best = v; }
            }
            if (!best) return;
            const e = fuzzyVocab[best];
            e.intents.forEach(i => { scores[i] = (scores[i] || 0) + 2 / e.intents.size; });
            if (e.langs.size === 1) ev[[...e.langs][0]] += 1;
            else if (e.langs.has('fr') && e.langs.has('en')) ev.shared += 1;
        });
        let bi = null, bs = 0;
        for (const i in scores) if (scores[i] > bs) { bs = scores[i]; bi = i; }
        return { intent: bi, ev };
    }

    // الغرض + أدلة لغوية من التصحيح الإملائي (إن استُعمل)
    function detectIntentEx(question) {
        const nq = normalize(question);
        if (BARE_LIBRARY.has(nq)) return { intent: 'library_services', ev: { ar: 0, fr: 0, en: 0 } };
        let best = null, bestScore = 0;
        for (const intent in compiled) {
            let score = 0;
            for (const { re, weight } of compiled[intent]) {
                if (re.test(nq)) score += weight;
            }
            if (score > bestScore) { bestScore = score; best = intent; }
        }
        if (bestScore > 1) return { intent: best, ev: { ar: 0, fr: 0, en: 0 } };
        // لا مطابقة (أو مطابقة ضعيفة جداً): نحاول تصحيح الأخطاء الإملائية
        const fz = fuzzyIntent(nq);
        if (fz.intent) return fz;
        return { intent: best, ev: { ar: 0, fr: 0, en: 0 } };
    }
    function detectIntent(question) { return detectIntentEx(question).intent; }

    // ====== 4) لغة الجواب تُحدَّد من السؤال نفسه وليس من الكلمة المطابقة ======
    // كلمات وظيفية شائعة تساعد على تمييز اللغة اللاتينية (فرنسية / إنجليزية)
    const FR_WORDS = new Set(["le","la","les","est","ou","quel","quelle","quels","quelles","comment","je","j","pour","des","du","une","sur","dans","mon","ma","mes","veux","sont","avec","que","qui","combien","quand","aux","peux","faut","bibliotheque","livre","livres","emprunter","horaires","heures","retard","faculte","universite","ouverture","bonjour","salut","merci","svp","fermeture","ouvert","ouverte","cherche","chercher","puis","je","nous","vous","au","en","et","il","elle"]);
    const EN_WORDS = new Set(["the","is","are","what","where","when","how","can","i","you","your","my","me","to","of","for","in","on","at","an","and","do","does","library","books","book","open","hours","time","who","which","there","have","has","get","find","want","need","please","about","with","from","this","that","hello","hi","thanks","thank","opening","closing","late","return"]);

    // لغة الجلسة: آخر لغة واضحة استعملها الطالب. تُستعمل فقط عند التباس السؤال (كلمة تُكتب بالإملاء نفسه في لغتين)
    let sessionLang = null;

    // كلمات مفتاحية مشتركة بين الفرنسية والإنجليزية بالإملاء نفسه: لا تدل على لغة، فتُستثنى من الأدلة
    const kwLangs = {};
    for (const intent in keywordsDictionary)
        for (const lang in keywordsDictionary[intent])
            for (const kw of keywordsDictionary[intent][lang])
                (kwLangs[normalize(kw)] = kwLangs[normalize(kw)] || new Set()).add(lang);
    const isSharedKw = k => kwLangs[k] && kwLangs[k].has('fr') && kwLangs[k].has('en');
    const SHARED_WORDS = new Set([...FR_WORDS].filter(w => EN_WORDS.has(w)));

    // مطابقة صارمة لأدلة اللغة: الكلمة اللاتينية كاملة مع لواحق الجمع/التصريف فقط (حتى لا تتسرب الأدلة بين الفرنسية والإنجليزية)
    function buildLangRegex(k) {
        if (/[a-z]/.test(k)) {
            const body = escapeRegex(k).replace(/ /g, '\\s+');
            return new RegExp('(^|[^a-z0-9])' + body + '(?:s|es|x|e|ed|ing|er|ers)?(?![a-z0-9])');
        }
        return buildRegex(k);
    }

    // مطابقة الكلمات المفتاحية لكل لغة على حدة: كلمة مفتاحية فرنسية خالصة = دليل على أن السؤال فرنسي
    const langRegex = { ar: [], fr: [], en: [] };
    for (const intent in keywordsDictionary)
        for (const lang in keywordsDictionary[intent])
            for (const kw of keywordsDictionary[intent][lang]) {
                const k = normalize(kw);
                if (langRegex[lang]) langRegex[lang].push({ re: buildLangRegex(k), w: k.split(' ').length, shared: isSharedKw(k) });
            }

    function detectLang(q, fz) {
        // كلمات عربية وأخرى لاتينية في سؤال واحد: تغلب اللغة الأكثر كلمات (والتعادل للعربية)
        const arTok = (q.match(/[\u0600-\u06FF]+/g) || []).length;
        const latTok = (q.match(/[a-zA-Z\u00C0-\u017F]+/g) || []).length;
        if (arTok && arTok >= latTok) return 'ar';
        if (/[àâçéèêëîïôûùüœ]/i.test(q)) return 'fr';
        const nq = normalize(q);
        let fr = 0, en = 0, sharedHit = false;
        nq.split(/[\s']+/).forEach(t => {
            if (SHARED_WORDS.has(t)) { sharedHit = true; return; }
            if (FR_WORDS.has(t)) fr++;
            if (EN_WORDS.has(t)) en++;
        });
        langRegex.fr.forEach(o => { if (o.re.test(nq)) { if (o.shared) sharedHit = true; else fr += 2 * o.w; } });
        langRegex.en.forEach(o => { if (o.re.test(nq)) { if (o.shared) sharedHit = true; else en += 2 * o.w; } });
        if (fz) { fr += 2 * fz.fr; en += 2 * fz.en; if (fz.shared) sharedHit = true; }
        // لا دليل واضح (مثل كلمة ناقصة أو بها خطأ: ouvertur): نبحث عن أقرب كلمة في القاموس
        if (fr === en) { const z = fuzzyIntent(nq).ev; fr += 2 * z.fr; en += 2 * z.en; if (z.shared) sharedHit = true; }
        if (fr > en) return 'fr';
        if (en > fr) return 'en';
        // التباس: نلتزم بلغة الجلسة حتى لا تتبدل اللغة فجأة؛ وبلا جلسة: الفرنسية للكلمة المشتركة، وإلا الإنجليزية
        return sessionLang || (sharedHit ? 'fr' : 'en');
    }

    function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ====== واجهة مبسّطة للطالب المبتدئ: زر تبديل لغة الجواب + رد بديل مفيد عند عدم الفهم ======
    const LANG_NAMES = [['ar', 'العربية'], ['fr', 'Français'], ['en', 'English']];
    function langSwitcher(intent, current) {
        return '<div class="lang-switch">' + LANG_NAMES.filter(l => l[0] !== current)
            .map(l => `<button type="button" class="lang-btn" onclick="showIn('${intent}','${l[0]}')">${l[1]}</button>`).join('') + '</div>';
    }
    const SUGGEST = {
        ar: ['الدوام', 'الموقع', 'الفهرس', 'التبرئة', 'الخدمات'],
        fr: ['horaires', 'localisation', 'catalogue', 'quitus', 'services'],
        en: ['hours', 'location', 'catalogue', 'clearance', 'services']
    };
    function fallbackHtml() {
        const btns = l => SUGGEST[l].map(w => `<button type="button" class="lang-btn" onclick="quickAsk('${w}','${l}')">${w}</button>`).join('');
        return `<div class="fb-row" dir="rtl" style="text-align:right">لم أجد جواباً لهذه الكلمة. اكتب <strong>كلمة واحدة فقط</strong> أو اضغط على إحداها: ${btns('ar')}</div>
            <div class="fb-row" dir="ltr" style="text-align:left">Je n'ai pas trouvé. Écrivez <strong>un seul mot</strong> ou cliquez sur l'un d'eux : ${btns('fr')}</div>
            <div class="fb-row" dir="ltr" style="text-align:left">I couldn't find that. Type <strong>just one word</strong> or tap one: ${btns('en')}</div>`;
    }
    function botAvatarHtml() {
        const a = document.querySelector('.msg-wrapper.bot .avatar');
        return a ? a.outerHTML : '';
    }
    function postBot(inner, cls, delay) {
        const chatHistory = document.getElementById("chat-history");
        setTimeout(() => {
            const typingRow = chatHistory.querySelector('.typing-row');
            if (typingRow) typingRow.remove();
            chatHistory.insertAdjacentHTML('beforeend', `
                <div class="msg-wrapper bot">
                    ${botAvatarHtml()}
                    <div class="message ${cls}">${inner}<span class="msg-time">${nowTimeStr()}</span></div>
                </div>`);
            chatHistory.scrollTop = chatHistory.scrollHeight;
        }, delay);
    }
    // نفس الجواب بلغة أخرى بضغطة واحدة (دون إعادة كتابة السؤال)
    function showIn(intent, lang) {
        const item = libraryData.find(i => i.intent === intent);
        if (!item) return;
        sessionLang = lang;
        postBot(item[lang].answer + langSwitcher(intent, lang), lang === 'ar' ? 'bot-message' : 'bot-message-ltr', 250);
    }

    function askQuestion(forceLang) {
        const inputField = document.getElementById("user-input");
        const originalQuestion = inputField.value.trim();
        
        if (!originalQuestion) return;

        const chatHistory = document.getElementById("chat-history");
        const ex = detectIntentEx(originalQuestion);
        const lang = (typeof forceLang === 'string') ? forceLang : detectLang(originalQuestion, ex.ev);
        sessionLang = lang;
        const userMsgClass = (lang === 'ar') ? "user-message" : "user-message-ltr";
        
        chatHistory.innerHTML += `
            <div class="msg-wrapper user">
                <div class="avatar"><svg class='fa-i' viewBox='0 0 448 512' aria-hidden='true'><path d='M241.3-13c-11.4-2.3-23.1-2.3-34.5 0L19.3 24.5C8.1 26.7 0 36.6 0 48c0 10.3 6.5 19.3 16 22.6V144L.3 222.6c-.2.9-.3 1.9-.3 2.9 0 8 6.5 14.6 14.6 14.6h34.9c8 0 14.6-6.5 14.6-14.6 0-1-.1-1.9-.3-2.9L48 144V77.3l48 9.6V144c0 70.7 57.3 128 128 128s128-57.3 128-128V86.9l76.7-15.3C439.9 69.3 448 59.4 448 48s-8.1-21.3-19.3-23.5zM224 224c-44.2 0-80-35.8-80-80h160c0 44.2-35.8 80-80 80m-103.9 96.1C58.7 348.3 16 410.3 16 482.3c0 16.4 13.3 29.7 29.7 29.7H200V366l-57.4-43c-6.5-4.9-15.2-6.2-22.6-2.8zM248 512h154.3c16.4 0 29.7-13.3 29.7-29.7 0-72-42.7-134-104.1-162.1-7.4-3.4-16.1-2.1-22.6 2.8l-57.4 43v146z'/></svg></div>
                <div class="message ${userMsgClass}">${escapeHtml(originalQuestion)}<span class="msg-time">${nowTimeStr()}</span></div>
            </div>`;

        chatHistory.insertAdjacentHTML('beforeend', `
            <div class="msg-wrapper bot typing-row">
                <div class="avatar"><svg class='fa-i' viewBox='0 0 640 512' aria-hidden='true'><path d='M352 0c0-17.7-14.3-32-32-32s-32 14.3-32 32v64h-96c-53 0-96 43-96 96v224c0 53 43 96 96 96h256c53 0 96-43 96-96V160c0-53-43-96-96-96h-96zM160 368c0-13.3 10.7-24 24-24h32c13.3 0 24 10.7 24 24s-10.7 24-24 24h-32c-13.3 0-24-10.7-24-24m120 0c0-13.3 10.7-24 24-24h32c13.3 0 24 10.7 24 24s-10.7 24-24 24h-32c-13.3 0-24-10.7-24-24m120 0c0-13.3 10.7-24 24-24h32c13.3 0 24 10.7 24 24s-10.7 24-24 24h-32c-13.3 0-24-10.7-24-24M224 176a48 48 0 1 1 0 96 48 48 0 1 1 0-96m144 48a48 48 0 1 1 96 0 48 48 0 1 1-96 0m-304 0c0-17.7-14.3-32-32-32S0 206.3 0 224v96c0 17.7 14.3 32 32 32s32-14.3 32-32zm544-32c-17.7 0-32 14.3-32 32v96c0 17.7 14.3 32 32 32s32-14.3 32-32v-96c0-17.7-14.3-32-32-32'/></svg></div>
                <div class="message bot-message"><div class="typing"><span></span><span></span><span></span></div></div>
            </div>`);
        chatHistory.scrollTop = chatHistory.scrollHeight;

        const botMsgClass = (lang === "ar") ? "bot-message" : "bot-message-ltr";
        const item = ex.intent ? libraryData.find(i => i.intent === ex.intent) : null;
        if (item) postBot(item[lang].answer + langSwitcher(ex.intent, lang), botMsgClass, 700);
        else postBot(fallbackHtml(), 'bot-message-ltr', 700);

        inputField.value = "";
        chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function quickAsk(q, lang) {
        document.getElementById("user-input").value = q;
        askQuestion(lang);
    }

    // ====== التاريخ والوقت وحالة المكتبة (بتوقيت الجزائر) ======
    const ALGIERS_TZ = 'Africa/Algiers';
    const WEEKDAYS_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    function getAlgiersNow() {
        const parts = {};
        new Intl.DateTimeFormat('en-US', { timeZone: ALGIERS_TZ, weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
            .formatToParts(new Date()).forEach(x => { parts[x.type] = x.value; });
        return { day: WEEKDAYS_EN.indexOf(parts.weekday), hour: parseInt(parts.hour, 10), minute: parseInt(parts.minute, 10) };
    }

    function formatTime(h, m) {
        return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
    }

    function nowTimeStr() {
        const n = getAlgiersNow();
        return formatTime(n.hour, n.minute);
    }

    // الدوام: من الأحد (0) إلى الخميس (4)، من 08:00 إلى 16:00
    function libraryStatus(day, minutes) {
        const OPEN = 8 * 60, CLOSE = 16 * 60;
        const isWorkDay = day >= 0 && day <= 4;
        if (isWorkDay && minutes >= OPEN && minutes < CLOSE) {
            return { open: true, text: 'المكتبة مفتوحة الآن' };
        }
        let when;
        if (isWorkDay && minutes < OPEN) when = 'تفتح اليوم 08:00';
        else if (day >= 0 && day <= 3) when = 'تفتح غداً 08:00';
        else when = 'تفتح الأحد 08:00';
        return { open: false, text: 'المكتبة مغلقة · ' + when };
    }

    function formatArabicDate() {
        try {
            return new Intl.DateTimeFormat('ar-DZ-u-nu-latn', { timeZone: ALGIERS_TZ, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());
        } catch (e) {
            return new Date().toLocaleDateString('ar');
        }
    }

    function updateClock() {
        const n = getAlgiersNow();
        const st = libraryStatus(n.day, n.hour * 60 + n.minute);
        const set = (id, txt) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
        set('date-text', formatArabicDate());
        set('time-text', formatTime(n.hour, n.minute));
        set('open-text', st.text);
        const badge = document.getElementById('open-badge');
        if (badge) badge.className = 'open-badge ' + (st.open ? 'open' : 'closed');
    }
    updateClock();
    setInterval(updateClock, 30000);


    // ====== فقاعة ترحيب تطفو عند الضغط على أيقونة الروبوت ======
    const BOT_MSGS = [
        { t: '🌿', rows: [['ع', 'مرحباً بك'], ['FR', 'Bienvenue'], ['EN', 'Welcome']] },
        { t: '😊', rows: [['ع', 'أنا هنا لمساعدتك'], ['FR', 'Je suis là pour vous aider'], ['EN', "I'm here to help you"]] },
        { t: '💡', ask: ['ar|دوام', 'fr|horaires', 'en|hours'], rows: [['ع', 'جرّب: دوام'], ['FR', 'Essayez : horaires'], ['EN', 'Try: hours']], hint: 'اضغط · Cliquez · Tap 👆' },
        { t: '🎓', rows: [['ع', 'بالتوفيق في دراستك'], ['FR', 'Bonne réussite !'], ['EN', 'Good luck with your studies']] }
    ];
    let botBubbleIdx = 0, botBubbleTimer = null;
    function closeBotBubble() {
        clearTimeout(botBubbleTimer);
        document.querySelectorAll('.bot-bubble').forEach(b => { b.classList.add('hide'); setTimeout(() => b.remove(), 260); });
    }
    function showBotBubble(avatar) {
        closeBotBubble();
        avatar.classList.remove('wiggle'); void avatar.offsetWidth; avatar.classList.add('wiggle');
        setTimeout(() => avatar.classList.remove('wiggle'), 900);
        const m = BOT_MSGS[botBubbleIdx++ % BOT_MSGS.length];
        const b = document.createElement('div');
        b.className = 'bot-bubble';
        b.setAttribute('role', 'status');
        b.innerHTML = '<div class="bb-title">' + m.t + '</div>' + m.rows.map((r, i) =>
            '<div class="bb-row' + (m.ask ? ' ask' : '') + '"' + (m.ask ? ' data-ask="' + m.ask[i] + '"' : '') + '><span class="bb-tag">' + r[0] + '</span><span class="bb-txt" dir="' + (r[0] === 'ع' ? 'rtl' : 'ltr') + '">' + r[1] + '</span></div>').join('') + (m.hint ? '<div class="bb-hint">' + m.hint + '</div>' : '');
        b.addEventListener('click', ev => {
            const row = ev.target.closest('.bb-row.ask');
            if (row) { const [l, w] = row.dataset.ask.split('|'); quickAsk(w, l); }
        });
        document.body.appendChild(b);
        const r = avatar.getBoundingClientRect(), bw = b.offsetWidth, bh = b.offsetHeight;
        const cx = r.left + r.width / 2;
        let left = Math.min(Math.max(12, cx - bw / 2), window.innerWidth - bw - 12);
        const up = r.top > bh + 24;
        b.classList.add(up ? 'up' : 'down');
        b.style.left = left + 'px';
        b.style.top = (up ? r.top - bh - 14 : r.bottom + 14) + 'px';
        b.style.setProperty('--tail', Math.min(Math.max(14, cx - left - 7), bw - 28) + 'px');
        b.style.setProperty('--tx', (cx - left) + 'px');
        b.style.setProperty('--ty', up ? '100%' : '0%');
        requestAnimationFrame(() => b.classList.add('show'));
        // شرارات صغيرة تتصاعد من الأيقونة
        ['✨', '🌿', '✨'].forEach((ch, i) => {
            const sp = document.createElement('span');
            sp.className = 'bb-spark'; sp.textContent = ch;
            sp.style.left = (cx - 7 + (i - 1) * 16) + 'px'; sp.style.top = (r.top + 4) + 'px';
            sp.style.setProperty('--dx', ((i - 1) * 18) + 'px'); sp.style.animationDelay = (i * 0.12) + 's';
            document.body.appendChild(sp); setTimeout(() => sp.remove(), 1600);
        });
        botBubbleTimer = setTimeout(closeBotBubble, 4800);
    }
    document.getElementById('chat-history').addEventListener('click', e => {
        const av = e.target.closest('.msg-wrapper.bot .avatar');
        if (av) { e.stopPropagation(); showBotBubble(av); }
    });
    document.addEventListener('click', e => { if (!e.target.closest('.msg-wrapper.bot .avatar')) closeBotBubble(); });

    document.getElementById("user-input").addEventListener("keypress", function(event) {
        if (event.key === "Enter") {
            event.preventDefault();
            askQuestion();
        }
    });
</script>

</body>
